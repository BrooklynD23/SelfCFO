-- Participant entity - Placeholder for Sprint 03

CREATE TABLE participant (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    email TEXT,
    phone TEXT,
    default_split_percent REAL,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    color TEXT,
    avatar_url TEXT
);

CREATE INDEX idx_participant_active ON participant(is_active);

insert:
INSERT INTO participant(id, name, email, phone, default_split_percent, is_active, created_at, color, avatar_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM participant WHERE is_active = 1 ORDER BY name;

selectById:
SELECT * FROM participant WHERE id = ?;

update:
UPDATE participant SET name = ?, email = ?, phone = ?, default_split_percent = ?, color = ?, avatar_url = ? WHERE id = ?;

deactivate:
UPDATE participant SET is_active = 0 WHERE id = ?;
