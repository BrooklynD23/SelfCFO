-- Receipt Item entity - Placeholder for Sprint 03

CREATE TABLE receipt_item (
    id TEXT NOT NULL PRIMARY KEY,
    receipt_id TEXT NOT NULL REFERENCES receipt(id),
    description TEXT NOT NULL,
    quantity REAL NOT NULL DEFAULT 1.0,
    unit_price_minor_units INTEGER NOT NULL,
    total_minor_units INTEGER NOT NULL,
    category_id TEXT REFERENCES category(id),
    sort_order INTEGER NOT NULL DEFAULT 0,
    notes TEXT
);

CREATE INDEX idx_receipt_item_receipt ON receipt_item(receipt_id);

insert:
INSERT INTO receipt_item(id, receipt_id, description, quantity, unit_price_minor_units, total_minor_units, category_id, sort_order, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByReceipt:
SELECT * FROM receipt_item WHERE receipt_id = ? ORDER BY sort_order;

selectById:
SELECT * FROM receipt_item WHERE id = ?;

update:
UPDATE receipt_item SET description = ?, quantity = ?, unit_price_minor_units = ?, total_minor_units = ?, category_id = ?, notes = ? WHERE id = ?;

deleteByReceipt:
DELETE FROM receipt_item WHERE receipt_id = ?;
