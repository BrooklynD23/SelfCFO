CREATE TABLE correction_event (
    id TEXT NOT NULL PRIMARY KEY,
    transaction_id TEXT NOT NULL REFERENCES imported_transaction(id),
    old_category_id TEXT REFERENCES category(id),
    new_category_id TEXT NOT NULL REFERENCES category(id),
    old_merchant TEXT,
    new_merchant TEXT,
    correction_source TEXT NOT NULL DEFAULT 'user',
    created_at INTEGER NOT NULL,
    CHECK (correction_source IN ('user', 'bulk', 'rule'))
);

CREATE INDEX idx_correction_event_transaction ON correction_event(transaction_id);
CREATE INDEX idx_correction_event_categories ON correction_event(old_category_id, new_category_id);
CREATE INDEX idx_correction_event_created ON correction_event(created_at);

insert:
INSERT INTO correction_event(id, transaction_id, old_category_id, new_category_id, old_merchant, new_merchant, correction_source, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectByTransaction:
SELECT * FROM correction_event WHERE transaction_id = ? ORDER BY created_at DESC;

selectRecent:
SELECT * FROM correction_event ORDER BY created_at DESC LIMIT ?;

selectByCategoryChange:
SELECT * FROM correction_event WHERE old_category_id = ? AND new_category_id = ?;

countByCategoryPair:
SELECT old_category_id, new_category_id, COUNT(*) AS correction_count
FROM correction_event
GROUP BY old_category_id, new_category_id
ORDER BY correction_count DESC;
